# Environment Variables
# Copy this file to .env.local and fill in your values

# Optional frontend variables
# NEXT_PUBLIC_API_URL=

# Persistent storage driver for procurement module
# memory (default) or supabase
PROCUREMENT_PERSISTENCE_DRIVER=memory

# Supabase connection for server-side persistence
# Recommended: service role key in server environment only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallbacks (if not using service role)
# SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
